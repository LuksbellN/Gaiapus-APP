{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiapus.local/contracts/yield-error.schema.json",
  "title": "Gaiapus yield request error",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "error"],
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product": {"const": "yield_estimate"},
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code"],
      "properties": {
        "code": {"enum": ["invalid_crop", "invalid_municipality_code", "municipality_not_covered"]}
      }
    }
  }
}
