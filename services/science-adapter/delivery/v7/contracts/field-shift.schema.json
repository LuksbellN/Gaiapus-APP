{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiapus.local/contracts/field-shift.schema.json",
  "title": "Gaiapus Field Shift scenario",
  "description": "Simulated water and soil-cover indicators for two successions in one municipality. No yield effect; the municipal yield estimate is a separate response.",
  "type": "object",
  "required": ["schema_version", "product", "generated_at", "municipality_code", "simulated", "sowing", "weather", "soil",
               "producer_priority", "hypotheses", "scenarios", "difference_brachiaria_minus_reference", "sensitivity",
               "daily_series_last_year", "not_simulated", "yield_effect", "yield_estimate_note", "evidence"],
  "$defs": {
    "indicators": {
      "type": "object",
      "required": ["covered_days", "off_season_water_use_mm", "off_season_drainage_mm", "storage_at_next_sowing_mm",
                   "soy_deficit_mm", "maize_deficit_mm", "maize_stress_days"],
      "properties": {
        "covered_days": {"type": "number", "minimum": 0, "maximum": 366},
        "off_season_water_use_mm": {"type": "number", "minimum": 0},
        "off_season_drainage_mm": {"type": "number", "minimum": 0},
        "storage_at_next_sowing_mm": {"type": "number", "minimum": 0},
        "soy_deficit_mm": {"type": "number", "minimum": 0},
        "maize_deficit_mm": {"type": "number", "minimum": 0},
        "maize_stress_days": {"type": "number", "minimum": 0},
        "next_soy_establishment_deficit_mm": {"type": ["number", "null"], "minimum": 0}
      }
    },
    "day": {
      "type": "object",
      "required": ["date", "land_cover", "stage", "soil_covered", "rain_mm", "et0_mm", "eta_mm", "et_deficit_mm", "storage_end_mm", "ks"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "land_cover": {"enum": ["soy", "maize2", "maize2+brachiaria", "brachiaria", "bare"]},
        "soil_covered": {"type": "boolean"},
        "storage_end_mm": {"type": "number", "minimum": 0},
        "ks": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product": {"const": "field_shift_scenario"},
    "generated_at": {"type": "string", "format": "date-time"},
    "municipality_code": {"type": "string", "pattern": "^[0-9]{7}$"},
    "simulated": {"const": true},
    "sowing": {
      "type": "object", "required": ["soy", "maize", "brachiaria"],
      "additionalProperties": {"type": "object", "required": ["origin"], "properties": {"origin": {"type": "string"}}}
    },
    "scenarios": {
      "type": "object", "required": ["reference_fallow", "brachiaria"],
      "additionalProperties": {"type": "object", "required": ["mean", "by_year"],
                               "properties": {"mean": {"$ref": "#/$defs/indicators"},
                                              "by_year": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["agricultural_year", "soy_sowing", "maize_sowing", "next_soy_sowing"]}}}}
    },
    "sensitivity": {"type": "array", "minItems": 1, "items": {"type": "object", "required": ["parameter", "value"]}},
    "daily_series_last_year": {
      "type": "object", "required": ["reference_fallow", "brachiaria"],
      "additionalProperties": {"type": "array", "minItems": 300, "items": {"$ref": "#/$defs/day"}}
    },
    "yield_effect": {"type": "null"}
  }
}
