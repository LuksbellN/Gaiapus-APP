# Node API; copy this file to .env at the repository root.
HOST=127.0.0.1
PORT=3001
# Both may be omitted for public-only local exploration.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server only; same secret configured in app_private.signing_config via SQL Editor.
APP_STORAGE_SIGNING_KEY=
SCIENCE_MODE=fixture
# Required only in live mode. Python must remain internal.
SCIENCE_ADAPTER_URL=http://127.0.0.1:8001
SCIENCE_INTERNAL_TOKEN=
SCIENCE_DEADLINE_MS=130000
# Optional; default apps/web/dist is served when present.
# FRONTEND_DIST_DIR=
# Python only: absolute manifest path to trusted hashed scientific delivery.
# SCIENCE_MANIFEST_PATH=
