{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://gaiapus.local/contracts/water-projection.schema.json",
  "title": "Gaiapus water-risk projection",
  "description": "Soil water, deficit and stress for N days after a decision, driven by the forecast issued before the request. Never converted into a yield effect.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "product", "status", "generated_at", "municipality_code", "location", "crop", "sowing_date", "sowing_basis",
               "decision_at", "crop_day_at_decision", "horizon_days_requested", "horizon_days_served", "max_validated_lead_days",
               "soil", "forecast", "initial_state", "days", "reference_days", "evaluation", "yield_effect", "yield_effect_note", "warnings"],
  "$defs": {
    "day": {
      "type": "object", "additionalProperties": false,
      "required": ["date", "lead_days", "crop_day", "phase", "rain_mm", "et0_mm", "storage_end_mm", "available_water_fraction",
                   "et_deficit_mm", "ks", "stress", "validated_lead"],
      "properties": {
        "date": {"type": "string", "format": "date"},
        "lead_days": {"type": "integer", "minimum": 1},
        "crop_day": {"type": "integer", "minimum": 0},
        "phase": {"enum": ["establishment", "vegetative", "reproductive", "maturation"]},
        "rain_mm": {"type": "number", "minimum": 0},
        "et0_mm": {"type": "number", "minimum": 0},
        "storage_end_mm": {"type": "number", "minimum": 0},
        "available_water_fraction": {"type": "number", "minimum": 0, "maximum": 1},
        "et_deficit_mm": {"type": "number", "minimum": 0},
        "ks": {"type": "number", "minimum": 0, "maximum": 1},
        "stress": {"type": "boolean"},
        "validated_lead": {"type": "boolean", "description": "False beyond the largest lead that passed the backtest"}
      }
    }
  },
  "properties": {
    "schema_version": {"const": "1.0.0"},
    "product": {"const": "water_risk_projection"},
    "status": {"enum": ["ready", "partially_validated", "not_supported"]},
    "generated_at": {"type": "string", "format": "date-time"},
    "municipality_code": {"type": "string", "pattern": "^[0-9]{7}$"},
    "location": {"type": "object", "additionalProperties": false, "required": ["latitude", "longitude"],
                 "properties": {"latitude": {"type": "number"}, "longitude": {"type": "number"}}},
    "crop": {"enum": ["soy", "maize2"]},
    "sowing_date": {"type": "string", "format": "date"},
    "sowing_basis": {"enum": ["hypothetical_fixed_calendar_per_state", "reported_by_user"]},
    "decision_at": {"type": "string", "format": "date-time"},
    "crop_day_at_decision": {"type": "integer"},
    "horizon_days_requested": {"type": "integer", "minimum": 1},
    "horizon_days_served": {"type": "integer", "minimum": 0},
    "max_validated_lead_days": {"type": "integer", "minimum": 0},
    "soil": {"type": "object", "additionalProperties": false, "required": ["cad_class", "capacity_mm", "initial_fraction_at_sowing", "basis"],
             "properties": {"cad_class": {"type": "string"}, "capacity_mm": {"type": "number"},
                            "initial_fraction_at_sowing": {"type": "number"}, "basis": {"type": "string"}}},
    "forecast": {"type": "object", "additionalProperties": false,
                 "required": ["provider", "model", "issued_at", "available_at", "retrieved_at", "issue_time_source"],
                 "properties": {"provider": {"type": "string"}, "model": {"type": "string"},
                                "issued_at": {"type": ["string", "null"], "format": "date-time"},
                                "available_at": {"type": ["string", "null"], "format": "date-time"},
                                "retrieved_at": {"type": "string", "format": "date-time"},
                                "issue_time_source": {"type": "string"}}},
    "initial_state": {"type": ["object", "null"], "additionalProperties": false,
                      "required": ["date", "storage_mm", "available_water_fraction", "observed_days", "observed_source"],
                      "properties": {"date": {"type": "string", "format": "date"}, "storage_mm": {"type": "number"},
                                     "available_water_fraction": {"type": "number"}, "observed_days": {"type": "integer"},
                                     "observed_source": {"type": "string"}}},
    "days": {"type": "array", "items": {"$ref": "#/$defs/day"}},
    "reference_days": {"type": "array", "items": {"$ref": "#/$defs/day"},
                       "description": "Same bucket driven by the 2001-2021 day-of-year climatology, for comparison"},
    "evaluation": {"type": "object", "additionalProperties": false, "required": ["method", "verification", "reference", "rule", "by_lead"],
                   "properties": {"method": {"type": "string"}, "verification": {"type": "string"}, "reference": {"type": "string"},
                                  "rule": {"type": "object"},
                                  "by_lead": {"type": "array", "items": {"type": "object", "additionalProperties": false,
                                     "required": ["lead_days", "storage_mae_mm", "reference_storage_mae_mm", "stress_accuracy", "coverage", "passed"],
                                     "properties": {"lead_days": {"type": "integer"}, "storage_mae_mm": {"type": "number"},
                                                    "reference_storage_mae_mm": {"type": "number"}, "stress_accuracy": {"type": "number"},
                                                    "coverage": {"type": "number"}, "passed": {"type": "boolean"}}}}}},
    "yield_effect": {"type": "null"},
    "yield_effect_note": {"type": "string"},
    "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
