{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2023",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client"
    ],
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "declaration": false,
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/teammate",
    "src/main.tsx",
    "src/features/auth",
    "src/lib/api",
    "src/test",
    "vite.config.ts",
    "vitest.config.ts"
  ]
}
