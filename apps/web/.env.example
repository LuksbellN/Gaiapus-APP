# Default development: canonical fixtures through development-only HTTP mocks.
# VITE_APP_API_MODE=mock
# To connect the Node application API, set this and restart Vite:
# VITE_APP_API_MODE=http

# Public browser credentials only. Never use a service-role or secret key here.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
