# The active frontend always reads supported products through the Node API.
# Vite proxies /v1 and /publications to http://127.0.0.1:3001.

# Public browser credentials only, for the same Supabase project as the API.
# Never use a service-role or secret key here. Restart Vite after changes.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
